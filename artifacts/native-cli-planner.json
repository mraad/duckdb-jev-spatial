{
  "plan": {
    "entity": "Wells",
    "filters": [
      {
        "field": "water_depth",
        "op": ">",
        "value": 350.0
      }
    ],
    "relation": {
      "target": "Pipelines",
      "predicate": "within_distance",
      "filters": [
        {
          "field": "current_phase",
          "op": "=",
          "value": "IN SERVICE"
        }
      ],
      "distance_m": 5000.0,
      "negate": false
    },
    "semantic": "Does the well status explicitly say that it is operating?",
    "semantic_fields": [
      "status"
    ]
  },
  "where": "w.\"water_depth\" > CAST(? AS DOUBLE PRECISION) AND w.\"geometry\" IS NOT NULL AND NOT ST_IsEmpty(w.\"geometry\") AND EXISTS (SELECT 1 FROM main.\"Pipelines\" p WHERE p.\"current_phase\" = ? AND p.\"geometry\" IS NOT NULL AND NOT ST_IsEmpty(p.\"geometry\") AND ST_DWithin(ST_Transform(w.\"geometry\", 'EPSG:4326', 'EPSG:3035', always_xy := TRUE), ST_Transform(p.\"geometry\", 'EPSG:4326', 'EPSG:3035', always_xy := TRUE), CAST(? AS DOUBLE PRECISION)))",
  "sql": "SELECT w.* FROM main.\"Wells\" w WHERE w.\"water_depth\" > CAST(? AS DOUBLE PRECISION) AND w.\"geometry\" IS NOT NULL AND NOT ST_IsEmpty(w.\"geometry\") AND EXISTS (SELECT 1 FROM main.\"Pipelines\" p WHERE p.\"current_phase\" = ? AND p.\"geometry\" IS NOT NULL AND NOT ST_IsEmpty(p.\"geometry\") AND ST_DWithin(ST_Transform(w.\"geometry\", 'EPSG:4326', 'EPSG:3035', always_xy := TRUE), ST_Transform(p.\"geometry\", 'EPSG:4326', 'EPSG:3035', always_xy := TRUE), CAST(? AS DOUBLE PRECISION)))",
  "parameters": [
    350.0,
    "IN SERVICE",
    5000.0
  ],
  "interpretation": [
    "depth → Wells.water_depth: Water depth at the well location, in meters.",
    "in-service → Pipelines.current_phase = 'IN SERVICE' (any pipeline type)",
    "distance → EPSG:3035 planar meters, longitude/latitude axis order",
    "within distance is inclusive; relation uses EXISTS, returning each well once"
  ],
  "sources": {
